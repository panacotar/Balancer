# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/

# Ignore bundler config.
/.bundle

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all environment files.
/.env*
!/.env.example

# Exclude entire runtime trees: re-including parent directories can accidentally
# include nested uploads, caches or development secrets in Docker's build context.
/log/
/tmp/
/storage/
/ngrok

# Ignore assets.
/node_modules/
/vendor/bundle/
/app/assets/builds/
/public/assets
/deploy/secrets/
/backups/
/dist/
/test/
/.github/
**/__pycache__/
/.release
/.previous-release
/.production-operation.lock/
