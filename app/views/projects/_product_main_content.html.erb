<div class="container">
  <div class="row">
    <div class="col">
      <div id="wraper-product-main-content">
        <div id="tab-product-action">
          <%if !current_user.nil?%>
          <ul id="product-action class=list-inline">
            <li class="list-inline-item">
              <% if @project.user == current_user %>
              <p><%= link_to " Edit Your Project", edit_project_path %></p>
            </li>
              <% end %>
            <% if @project.user != current_user%>
            <li class="list-inline-item">
            <h6><i class="fas fa-envelope"></i><strong> Contact Founders</strong></h6>
            </li>
            <% end %>
            <li class="list-inline-item">
              <% if @project.user == current_user %>
              <p><%= link_to "Create a Campaign", new_project_campaign_path(@project) %></p>
            </li>
              <% end %>
            <li class="list-inline-item">
              <% if @project.user == current_user %>
              <p><%= link_to " Your Dashboard", dashboard_path %></p>
            </li>
              <% end %>
          </ul>
          <% end %>
        </div>
        <div id="wraper-product-info">
          <div id="wraper-product-info-categories">
            <div id="wraper-product-info-categories-item">
              <% if @project.user == current_user && @project.campaigns.any? %>
                <h3>Campaigns</h3>
                <ol id="project-campaign-list">
                  <% @project.campaigns.order(:id).each do |campaign| %>
                    <li>
                      <span><%= campaign.name %></span>
                      <%= link_to edit_project_campaign_path(@project, campaign), aria: { label: "Edit #{campaign.name}" } do %>
                        <i class="fas fa-pen" aria-hidden="true"></i>
                      <% end %>
                    </li>
                  <% end %>
                </ol>
              <% end %>
              <h3>PROJECT VISION</h3>
              <h6><%= @project.vision %><h6>
              <div id="project-photo"> 
              <%= image_tag @project.photo, class: "w-100" %>
              </div>
              <h3>PITCH</h3>
              <h6><%= @project.pitch %><h6>
              <h3>AUDIENCE</h3>
              <h6><%= @project.target %><h6>
            </div>
          </div>
        </div>
      </div>   
    </div>   
  </div>     
</div>
<div>