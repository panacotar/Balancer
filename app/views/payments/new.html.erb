<div class="container checkout_wrap">
  <div class="row py-4">
    <div class="col-md-4">
      <% if @order.campaign.project.photo.attached? %>
        <%= attachment_image_tag @order.campaign.project.photo, width: '100%', class: "checkout-img" %>
      <% end %>
    </div>
    <div class="col">
      <h1 class="checkout-title">Checkout summary</h1>
      <p class="checkout-text">Thank you for supporting this project!</p>
      <p class="checkout-text">Invest <strong><%= humanized_money_with_symbol @order.amount %></strong> into <strong><%= @order.campaign.name %></strong> </p>
      <p class="alert alert-info">Demo checkout — Stripe test mode only. No real payment is collected.</p>
      <%= link_to 'Continue to Stripe test checkout', @checkout_url, class: 'btn btn-primary', data: { turbolinks: false } %>
    </div>
  </div>
</div>
