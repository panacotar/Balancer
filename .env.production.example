# Public configuration. scripts/setup-production.sh copies this to .env.production
# and fills in SECRET_KEY_BASE, BALANCER_DATABASE_PASSWORD, GIT_SHA, and CADDY_PROFILE.
# Do not put live Stripe keys here. This demo accepts test keys only.
DOMAIN=balancer.organicdarius.com
GIT_SHA=
SECRET_KEY_BASE=
BALANCER_DATABASE_PASSWORD=

# Set only when scripts/setup-production.sh finds ports 80/443 free and
# starts Balancer's own Caddy. Leave blank if another reverse proxy already
# owns those ports. See doc/vps.md.
ACME_EMAIL=
CADDY_PROFILE=

# Stripe test keys. STRIPE_WEBHOOK_SECRET signs POST /stripe/webhook.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional error reporting.
SENTRY_DSN=

# Optional password-reset email. Leave SMTP_ADDRESS empty to boot without mail.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
