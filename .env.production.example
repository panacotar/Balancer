# Public configuration. scripts/setup-production.sh copies this to .env.production
# and fills in SECRET_KEY_BASE, BALANCER_DATABASE_PASSWORD, and GIT_SHA.
# Do not put live Stripe keys here. This demo accepts test keys only.
DOMAIN=balancer.organicdarius.com
GIT_SHA=
SECRET_KEY_BASE=
BALANCER_DATABASE_PASSWORD=

# Stripe test keys. STRIPE_WEBHOOK_SECRET signs POST /stripe/webhook.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional error reporting.
SENTRY_DSN=

# Optional password-reset email. Leave SMTP_ADDRESS empty to boot without mail.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
