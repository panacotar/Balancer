# Development works with local PostgreSQL and local image storage.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=your_local_postgres_role
# PGPASSWORD=
# DATABASE_URL=postgresql://localhost/Balancer_development
# Set DOMAIN when generating absolute checkout URLs on another hostname.
DOMAIN=localhost:3000

# Optional: development and production otherwise use persistent local storage.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Demo checkout is disabled until BOTH Stripe test keys are configured.
# STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Optional error reporting.
# SENTRY_DSN=
